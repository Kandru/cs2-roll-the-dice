/* ============================================================================
   Roll The Dice info menu v3 (info_v3.xml, contract: src/Hud/InfoMenuIds.cs).
   Modal, centred, mouse driven ("!dice info"). Look follows the Challenges
   "tactical" menu: square panel, accent corner brackets, "//" kicker, index
   boxes, nav rail with active bar.
   Hex colours only (no variables, no functional colours). Unitless font-size.

   Tokens: panel #0a0d11eb  raised #ffffff08  hover #ffffff14  press #ffffff24
           hairline #ffffff1f / #ffffff14  ink #f5f7fa  ink-soft #e8eef4
           muted #a3acb6  accent = theme (gold #f0a531)  info #5aa9e6
           success #9ccf4f  danger #e05a5a
   Root ri-root carries: is-off / is-fading, view-round | view-list | view-perks | view-settings, theme-*.
   Team rows ri-ctr-N / ri-tr-N carry: is-off, tone-*, life-alive|dead, is-self.
   Rows ri-row-N carry: is-off, tone-none|good|bad|neutral, team-none|ct|t, life-alive|dead, is-self.
   Accent only for brackets, kicker, index boxes, active state and own entries;
   semantic colours (tone, alive/dead) never follow the theme.
   Spacing on a 4px grid; horizontal insets are RiPad spacers (width:100%
   children ignore padding). Motion: hover 0.15s, card 0.25s in / 0.18s out.
   ============================================================================ */

/* Screen + card ---------------------------------------------------------------- */

.RiScreen
{
	width: 100%;
	height: 100%;
	z-index: 99999;
}

.RiCard
{
	width: 960px;
	height: 800px;
	horizontal-align: center;
	vertical-align: middle;
	flow-children: none;
	opacity: 1;
	transform: translateY( 0px );
	transition-property: opacity, transform;
	transition-duration: 0.25s;
	transition-timing-function: ease-out;
}

.RiCard.is-fading
{
	opacity: 0;
	transform: translateY( 8px );
	transition-duration: 0.18s;
	transition-timing-function: ease-in;
}

.RiCard.is-off
{
	visibility: collapse;
	opacity: 0;
	transition-duration: 0s;
}

.RiBg
{
	width: 100%;
	height: 100%;
	background-color: #0a0d11eb;
	border: 1px solid #ffffff1f;
	box-shadow: #000000b0 0px 10px 32px 0px;
	world-blur: gaussian( 2 );
}

.RiCorner
{
	width: 12px;
	height: 12px;
	border-top: 2px solid #f0a531;
	border-left: 2px solid #f0a531;
	z-index: 6;
}

.RiCornerTL { horizontal-align: left; vertical-align: top; }
.RiCornerTR { horizontal-align: right; vertical-align: top; transform: rotateZ( 90deg ); }
.RiCornerBR { horizontal-align: right; vertical-align: bottom; transform: rotateZ( 180deg ); }
.RiCornerBL { horizontal-align: left; vertical-align: bottom; transform: rotateZ( 270deg ); }

.RiContent
{
	width: 100%;
	height: 100%;
	flow-children: down;
	z-index: 2;
}

.RiPad
{
	width: 16px;
	height: 100%;
}

.RiVPad
{
	width: 100%;
	height: 16px;
}

/* Head ------------------------------------------------------------------------- */

.RiHead
{
	width: 100%;
	height: 60px;
	flow-children: right;
	padding-left: 20px;
	padding-right: 16px;
	border-bottom: 1px solid #ffffff14;
}

Label.RiKicker
{
	vertical-align: middle;
	margin-right: 12px;
	font-size: 20;
	letter-spacing: 1px;
	color: #f0a531;
}

Label.RiTitle
{
	vertical-align: middle;
	font-size: 24;
	letter-spacing: 2px;
	text-transform: uppercase;
	color: #f5f7fa;
}

Label.RiSub
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	margin-left: 16px;
	font-size: 20;
	letter-spacing: 1px;
	color: #a3acb6;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.RiClose
{
	width: 38px;
	height: 38px;
	flow-children: none;
	vertical-align: middle;
	margin-left: 16px;
	background-color: #ffffff08;
	border: 1px solid #ffffff33;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.RiClose:hover
{
	background-color: #e05a5a44;
	border: 1px solid #e05a5a;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.RiClose:active
{
	background-color: #e05a5a88;
	sound: "UIPanorama.generic_button_press";
}

.RiCloseX
{
	width: 16px;
	height: 2px;
	horizontal-align: center;
	vertical-align: middle;
	background-color: #f5f7fa;
}

.RiCloseA { transform: rotateZ( 45deg ); }
.RiCloseB { transform: rotateZ( -45deg ); }

/* Body: nav rail + main --------------------------------------------------------- */

.RiBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: right;
}

.RiRail
{
	width: 240px;
	height: 100%;
	flow-children: down;
	padding-top: 16px;
}

Label.RiRailHead
{
	margin-left: 16px;
	margin-bottom: 8px;
	font-size: 16;
	letter-spacing: 3px;
	text-transform: uppercase;
	color: #a3acb6;
}

.RiNav
{
	width: 100%;
	height: 44px;
	flow-children: right;
	padding-left: 13px;
	padding-right: 16px;
	margin-bottom: 2px;
	background-color: #00000000;
	border-left: 3px solid #00000000;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.RiNav:hover
{
	background-color: #ffffff0d;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.RiNav:active
{
	background-color: #ffffff1a;
	sound: "UIPanorama.generic_button_press";
}

.RiNav.is-active
{
	background-color: #f0a5311f;
	border-left: 3px solid #f0a531;
}

Label.RiNavLabel
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 18;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.RiNavCount
{
	vertical-align: middle;
	margin-left: 8px;
	font-size: 18;
	color: #a3acb6;
}

.RiNav.is-active Label.RiNavLabel { color: #f5f7fa; }
.RiNav.is-active Label.RiNavCount { color: #f0a531; }

.RiMain
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: right;
	border-left: 1px solid #ffffff14;
}

.RiInner
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
}

/* Section bar: title left, count right ------------------------------------------ */

.RiBar
{
	width: 100%;
	height: 36px;
	flow-children: right;
	margin-bottom: 8px;
}

Label.RiSection
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 16;
	letter-spacing: 3px;
	text-transform: uppercase;
	color: #a3acb6;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.RiCount
{
	vertical-align: middle;
	margin-left: 12px;
	font-size: 18;
	letter-spacing: 1px;
	color: #f0a531;
}

/* Perk tools: tone filter chips, sort chip, search line --------------------------- */

.RiTools
{
	width: 100%;
	height: 34px;
	flow-children: right;
	margin-bottom: 8px;
}

.RiFilters
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: right;
}

.RiChip
{
	height: 34px;
	flow-children: none;
	padding-left: 12px;
	padding-right: 12px;
	margin-right: 6px;
	background-color: #ffffff08;
	border: 1px solid #ffffff1f;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.RiChip:hover
{
	background-color: #ffffff14;
	border: 1px solid #f0a53166;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.RiChip:active
{
	background-color: #ffffff24;
	sound: "UIPanorama.generic_button_press";
}

.RiChip.is-active
{
	background-color: #f0a5311f;
	border: 1px solid #f0a531;
}

.RiChip.RiSort
{
	margin-right: 0px;
}

Label.RiChipLabel
{
	vertical-align: middle;
	font-size: 15;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
}

.RiChip.is-active Label.RiChipLabel { color: #f5f7fa; }

.RiSearchBar
{
	width: 100%;
	height: 32px;
	flow-children: right;
	margin-bottom: 8px;
}

.RiSearch
{
	height: 32px;
	flow-children: right;
	padding-left: 10px;
	margin-right: 12px;
	background-color: #f0a5311f;
	border: 1px solid #f0a531;
}

.RiSearch.is-off
{
	visibility: collapse;
}

Label.RiSearchLabel
{
	vertical-align: middle;
	margin-right: 8px;
	font-size: 15;
	color: #f5f7fa;
}

.RiSearchClear
{
	width: 30px;
	height: 30px;
	flow-children: none;
	vertical-align: middle;
	background-color: #00000000;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.RiSearchClear:hover
{
	background-color: #e05a5a44;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.RiSearchClear:active
{
	background-color: #e05a5a88;
	sound: "UIPanorama.generic_button_press";
}

.RiSearchClear .RiCloseX
{
	width: 12px;
}

Label.RiSearchHint
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 15;
	color: #a3acb6;
	text-overflow: ellipsis;
	white-space: nowrap;
}

/* Views: the root class picks settings, a plain list or the perk list ----------- */

.RiViews
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: none;
}

.RiCard.view-round .RiSettings,
.RiCard.view-round .RiList,
.RiCard.view-round .RiTools,
.RiCard.view-round .RiSearchBar,
.RiCard.view-list .RiSettings,
.RiCard.view-list .RiTools,
.RiCard.view-list .RiSearchBar,
.RiCard.view-list .RiRound,
.RiCard.view-perks .RiSettings,
.RiCard.view-perks .RiRound,
.RiCard.view-settings .RiList,
.RiCard.view-settings .RiTools,
.RiCard.view-settings .RiSearchBar,
.RiCard.view-settings .RiRound,
.RiCard.view-settings Label.RiCount
{
	visibility: collapse;
}

/* Settings view ------------------------------------------------------------------ */

.RiSettings
{
	width: 100%;
	height: 100%;
	flow-children: down;
}

Label.RiGroup
{
	margin-top: 24px;
	margin-bottom: 8px;
	font-size: 16;
	letter-spacing: 3px;
	text-transform: uppercase;
	color: #a3acb6;
}

Label.RiGroup.RiGroupFirst
{
	margin-top: 0px;
}

.RiSwitch
{
	width: 100%;
	height: 56px;
	flow-children: right;
	padding-left: 16px;
	padding-right: 16px;
	background-color: #ffffff08;
	border: 1px solid #ffffff1f;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.RiSwitch:hover
{
	background-color: #ffffff14;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.RiSwitch:active
{
	background-color: #ffffff24;
	sound: "UIPanorama.generic_button_press";
}

.RiSwitch.is-disabled,
.RiSwitch.is-disabled:hover
{
	opacity: 0.35;
	background-color: #ffffff08;
	cursor: default;
	sound: "";
}

Label.RiSwitchLabel
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 20;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #f5f7fa;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.RiSwitchState
{
	vertical-align: middle;
	margin-right: 16px;
	font-size: 18;
	letter-spacing: 2px;
	text-transform: uppercase;
	color: #a3acb6;
}

.RiSwitch.is-on Label.RiSwitchState { color: #f0a531; }

.RiSwitchTrack
{
	width: 48px;
	height: 24px;
	flow-children: none;
	vertical-align: middle;
	background-color: #ffffff14;
	border: 1px solid #ffffff33;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.RiSwitch.is-on .RiSwitchTrack
{
	background-color: #f0a53133;
	border: 1px solid #f0a531;
}

.RiSwitchKnob
{
	width: 16px;
	height: 16px;
	margin-left: 3px;
	vertical-align: middle;
	background-color: #a3acb6;
	transform: translateX( 0px );
	transition-property: transform, background-color;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.RiSwitch.is-on .RiSwitchKnob
{
	background-color: #f0a531;
	transform: translateX( 24px );
}

/* explicit height: fit-children around buttons is not reliable in Panorama */
.RiLangs
{
	width: 100%;
	height: 44px;
	flow-children: right;
}

.RiLang
{
	width: 200px;
	height: 44px;
	flow-children: none;
	margin-right: 8px;
	background-color: #ffffff08;
	border: 1px solid #ffffff1f;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.RiLang:hover
{
	background-color: #ffffff14;
	border: 1px solid #f0a53166;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.RiLang:active
{
	background-color: #ffffff24;
	sound: "UIPanorama.generic_button_press";
}

.RiLang.is-active
{
	background-color: #f0a5311f;
	border: 1px solid #f0a531;
}

Label.RiLangLabel
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-size: 18;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
}

.RiLang.is-active Label.RiLangLabel { color: #f5f7fa; }

Label.RiHint
{
	width: 100%;
	margin-top: 8px;
	font-size: 16;
	color: #a3acb6;
}

/* above the language buttons: a hint after them left a large gap in game */
Label.RiHint.RiHintAbove
{
	margin-top: 0px;
	margin-bottom: 10px;
}

/* List: one scrollable page over a fixed pool of single-line rows ----------------
   The client scrolls (mouse wheel while input capture is on); the server never
   reads or sets the position. Rows have a fixed width so the scroll bar has room. */

.RiList
{
	width: 100%;
	height: 100%;
	flow-children: down;
	overflow: squish scroll;
}

.RiRow
{
	width: 668px;
	height: 40px;
	flow-children: right;
	margin-bottom: 4px;
	padding-left: 8px;
	padding-right: 12px;
	background-color: #ffffff08;
	border: 1px solid #ffffff1f;
}

.RiRow.is-off
{
	visibility: collapse;
}

.RiRow.is-self
{
	background-color: #f0a5311f;
	border: 1px solid #f0a531;
}

.RiIdx
{
	width: 40px;
	height: 26px;
	flow-children: none;
	vertical-align: middle;
	margin-right: 10px;
	border: 1px solid #f0a531;
}

Label.RiIdxLabel
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-size: 15;
	letter-spacing: 1px;
	color: #f0a531;
}

/* Team badge in the index box (round list): the text says CT / T, the colour helps.
   Extra ancestors: outranks the theme rules below. */
.RiCard .RiList .RiRow.team-ct .RiIdx { border-color: #96c8fa; background-color: #96c8fa1f; }
.RiCard .RiList .RiRow.team-t .RiIdx { border-color: #eabe54; background-color: #eabe541f; }
.RiCard .RiList .RiRow.team-ct Label.RiIdxLabel { color: #96c8fa; }
.RiCard .RiList .RiRow.team-t Label.RiIdxLabel { color: #eabe54; }

/* Tone shape (same as the reel): a rotated square clipped to its top half
   (good, ▲), the same box turned by 180deg (bad, ▼) or shown small
   (neutral, ◆). The word in the meta column carries the meaning as text. */
.RiMark
{
	width: 22px;
	height: 100%;
}

.RiRow.tone-none .RiMark
{
	visibility: collapse;
}

.RiMarkBox
{
	width: 17px;
	height: 9px;
	horizontal-align: left;
	vertical-align: middle;
	overflow: clip clip;
}

.RiMarkTip
{
	width: 6px;
	height: 6px;
	margin-left: 5px;
	margin-top: 1px;
	background-color: #5aa9e6;
	transform: rotateZ( 45deg );
}

.RiRow.tone-good .RiMarkTip { width: 12px; height: 12px; margin-left: 2px; margin-top: 3px; background-color: #9ccf4f; }
.RiRow.tone-bad .RiMarkTip { width: 12px; height: 12px; margin-left: 2px; margin-top: 3px; background-color: #e05a5a; }
.RiRow.tone-bad .RiMarkBox { transform: rotateZ( 180deg ); }

/* Titles are commands and player names too: no uppercase transform. */
Label.RiRowTitle
{
	width: 180px;
	vertical-align: middle;
	font-size: 17;
	letter-spacing: 0.5px;
	color: #f5f7fa;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.RiRowDesc
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	margin-left: 12px;
	font-size: 15;
	color: #c9d2dc;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.RiRowMeta
{
	width: 90px;
	vertical-align: middle;
	margin-left: 12px;
	font-size: 15;
	letter-spacing: 1px;
	text-transform: uppercase;
	text-align: right;
	color: #a3acb6;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.RiRow.tone-good Label.RiRowMeta { color: #9ccf4f; }
.RiRow.tone-bad Label.RiRowMeta { color: #e05a5a; }
.RiRow.tone-neutral Label.RiRowMeta { color: #5aa9e6; }
/* Dead players (round list): red frame, greyed text - no status label. Extra ancestors:
   outranks is-self and the theme rules, so an own dead row is red as well. */
.RiCard .RiList .RiRow.life-dead { background-color: #e05a5a14; border: 1px solid #e05a5a; }
.RiCard .RiList .RiRow.life-dead Label.RiRowTitle,
.RiCard .RiList .RiRow.life-dead Label.RiRowDesc { color: #6b737c; }
.RiCard .RiList .RiRow.life-dead .RiIdx,
.RiCard .RiList .RiRow.life-dead .RiMark { opacity: 0.45; }

Label.RiEmpty
{
	width: 100%;
	height: 56px;
	font-size: 18;
	text-align: center;
	color: #a3acb6;
}

Label.RiEmpty.is-off
{
	visibility: collapse;
}

/* Round view: CT and T side by side, each column its own scrolled row pool ---------- */

.RiRound
{
	width: 100%;
	height: 100%;
	flow-children: right;
}

.RiTeamCol
{
	width: 336px;
	height: 100%;
	flow-children: down;
}

.RiTeamColCT
{
	margin-right: 14px;
}

.RiTeamHead
{
	width: 100%;
	height: 34px;
	flow-children: right;
	margin-bottom: 8px;
	padding-left: 10px;
	padding-right: 12px;
	background-color: #ffffff08;
	border-top: 2px solid #ffffff33;
}

.RiTeamColCT .RiTeamHead { border-top: 2px solid #96c8fa; background-color: #96c8fa14; }
.RiTeamColT .RiTeamHead { border-top: 2px solid #eabe54; background-color: #eabe5414; }

Label.RiTeamTitle
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 16;
	letter-spacing: 2px;
	text-transform: uppercase;
	color: #f5f7fa;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.RiTeamCount
{
	vertical-align: middle;
	font-size: 16;
	color: #a3acb6;
}

.RiTeamColCT Label.RiTeamTitle, .RiTeamColCT Label.RiTeamCount { color: #96c8fa; }
.RiTeamColT Label.RiTeamTitle, .RiTeamColT Label.RiTeamCount { color: #eabe54; }

.RiTeamList
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	overflow: squish scroll;
}

/* fixed width: room for the scroll bar on the right */
.RiTeamRow
{
	width: 322px;
	height: 40px;
	flow-children: right;
	margin-bottom: 4px;
	padding-left: 8px;
	padding-right: 10px;
	background-color: #ffffff08;
	border: 1px solid #ffffff1f;
}

.RiTeamRow.is-off
{
	visibility: collapse;
}

.RiTeamRow.is-self
{
	background-color: #f0a5311f;
	border: 1px solid #f0a531;
}

.RiTeamRow.tone-none .RiMark
{
	visibility: collapse;
}

.RiTeamRow.tone-good .RiMarkTip { width: 12px; height: 12px; margin-left: 2px; margin-top: 3px; background-color: #9ccf4f; }
.RiTeamRow.tone-bad .RiMarkTip { width: 12px; height: 12px; margin-left: 2px; margin-top: 3px; background-color: #e05a5a; }
.RiTeamRow.tone-bad .RiMarkBox { transform: rotateZ( 180deg ); }

Label.RiTeamName
{
	width: 130px;
	vertical-align: middle;
	font-size: 16;
	color: #f5f7fa;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.RiTeamDice
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	margin-left: 10px;
	font-size: 15;
	color: #c9d2dc;
	text-overflow: ellipsis;
	white-space: nowrap;
}

/* Dead players: red frame, greyed text - no status label. Extra ancestors:
   outranks is-self and the theme rules, so an own dead row is red as well. */
.RiCard .RiRound .RiTeamRow.life-dead { background-color: #e05a5a14; border: 1px solid #e05a5a; }
.RiCard .RiRound .RiTeamRow.life-dead Label.RiTeamName,
.RiCard .RiRound .RiTeamRow.life-dead Label.RiTeamDice { color: #6b737c; }
.RiCard .RiRound .RiTeamRow.life-dead .RiMark { opacity: 0.45; }

Label.RiTeamEmpty
{
	width: 100%;
	height: 40px;
	font-size: 16;
	text-align: center;
	color: #a3acb6;
}

Label.RiTeamEmpty.is-off
{
	visibility: collapse;
}

/* Foot -------------------------------------------------------------------------- */

.RiFoot
{
	width: 100%;
	height: 44px;
	flow-children: none;
	padding-left: 20px;
	padding-right: 20px;
	border-top: 1px solid #ffffff14;
}

Label.RiFootHint
{
	horizontal-align: left;
	vertical-align: middle;
	font-size: 16;
	letter-spacing: 1px;
	color: #e8eef4;
}

Label.RiCredit
{
	horizontal-align: right;
	vertical-align: middle;
	font-size: 16;
	letter-spacing: 1px;
	color: #a3acb6;
}

